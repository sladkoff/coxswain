{
  "name": "coxswain",
  "version": "1.9.2",
  "private": true,
  "description": "A local ADE (agentic development environment) for reviewing pull requests with local coding agents",
  "author": "Leonid Rousseau",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron.mjs dev --watch",
    "build": "electron-vite build",
    "start": "node scripts/run-electron.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "postinstall": "install-electron && node scripts/build-native-glass.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "icon": "node scripts/build-icon.mjs",
    "dist": "electron-vite build && electron-builder",
    "native:glass": "node scripts/build-native-glass.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.2",
    "@agentclientprotocol/codex-acp": "1.13.1",
    "@agentclientprotocol/sdk": "1.5.0",
    "@octokit/core": "^7.0.8",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.40",
    "electron-glasskit": "0.1.0",
    "kysely": "0.29.6",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ts-pattern": "5.9.0",
    "typescript": "7.0.2",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.coxswain.app",
    "productName": "coxswain",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/icon-concepts/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/@openai/codex*/**"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/@typescript/typescript-*/**",
      "node_modules/electron-glasskit/**"
    ]
  }
}
